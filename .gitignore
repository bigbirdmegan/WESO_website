# raw inbox for new recordings - R/sync_from_wavs.R copies the ones it
# processes into www/audio/, which is what actually gets committed
wavs/

# personal photo library / scratch space - move a resized copy into
# www/banners/ or www/team/ to actually use one on the site
data/photos/

# raw/original logo files - processed copies live at www/logo.png and
# www/partners/<name>.png (see R/resize_image.R)
logos/

# local dev-server config, not part of the site
.claude/
